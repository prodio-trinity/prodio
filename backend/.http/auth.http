### =====================================================
### QA-2. 회원가입 후 PENDING 상태 확인
### =====================================================
GET http://localhost:8080/auth/csrf

> {%
  client.global.set("csrfToken", response.body.token);
%}

###

### QA-2. 회원가입
POST http://localhost:8080/auth/signup
Content-Type: application/json
X-PRODIO-XSRF-TOKEN: {{csrfToken}}

{
  "email": "pending-test@prodio.com",
  "password": "test1234!",
  "name": "QA테스트유저"
}

> {%
  client.test("회원가입 성공 + PENDING 권한", function() {
    client.assert(response.status === 201, "201 이어야 함");
    client.assert(response.body.roles.includes("PENDING"), "PENDING 권한 있어야 함");
  });
%}

###

### QA-2. PENDING 계정으로 로그인
