### =====================================================
### QA-1. CSRF 토큰 발급
### =====================================================
GET http://localhost:8080/auth/csrf

> {%
  client.global.set("csrfToken", response.body.token);
  client.global.set("csrfHeader", response.body.headerName);
  client.test("CSRF 토큰 발급 성공", function() {
    client.assert(response.status === 200, "200 이어야 함");
    client.assert(response.body.token !== null, "token 있어야 함");
  });
%}

###

### QA-1. 로그인 성공 (ADMIN)
POST http://localhost:8080/auth/login
Content-Type: application/json
X-PRODIO-XSRF-TOKEN: {{csrfToken}}

{
  "email": "admin@prodio.com",
  "password": "admin1234"
}

> {%
  client.test("로그인 성공", function() {
    client.assert(response.status === 200, "200 이어야 함");
  });
%}

###

### QA-1. 로그인 실패 - 비밀번호 오류
POST http://localhost:8080/auth/login
Content-Type: application/json
X-PRODIO-XSRF-TOKEN: {{csrfToken}}

{
  "email": "admin@prodio.com",
  "password": "wrongpassword"
}

> {%
  client.test("비밀번호 오류 시 401", function() {
    client.assert(response.status === 401, "401 이어야 함");
    client.assert(response.body.message !== null, "오류 메시지 있어야 함");
  });
%}

###

### QA-1. 로그인 실패 - 존재하지 않는 이메일
POST http://localhost:8080/auth/login
Content-Type: application/json
X-PRODIO-XSRF-TOKEN: {{csrfToken}}

{
  "email": "notexist@prodio.com",
  "password": "admin1234"
}

> {%
  client.test("없는 이메일 시 401", function() {
    client.assert(response.status === 401, "401 이어야 함");
  });
%}

